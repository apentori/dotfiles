{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "openai/gpt-oss-20b": {
          "name": "My vLLM model"
        }
      }
    }
  },
  "model": "mistral/devstral-2",
  "small_model": "vllm/openai/gpt-oss-20b",
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "rm": "deny",
      "ls": "allow",
      "grep *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.crt": "deny",
      "*.key": "deny",
      "*.pki": "deny"
    },
    "glob": "allow",
    "edit": "ask",
    "list": "allow",
    "skill": "ask",
    "lsp": "ask",
    "webserch": "ask",
    "todowrite": "ask",
    "todoread": "ask",
    "external_directory": {
      "*": "deny"
    }
  },
  "plugin": [
    "micode"
  ]
}
